{
  "manifest_version": 3,
  "name": "AI Chat Contract Watch",
  "version": "0.6.0",
  "description": "Privately monitors AI chat API and selection DOM contracts used by AI Chat Export.",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background-wrapper.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Chat Contract Watch",
    "default_popup": "popup.html"
  }
}

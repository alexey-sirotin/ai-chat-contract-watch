{
  "manifest_version": 3,
  "name": "AI Chat Contract Watch",
  "version": "0.1.0",
  "description": "Privately monitors AI chat server contracts used by AI Chat Export.",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Chat Contract Watch",
    "default_popup": "popup.html"
  }
}
